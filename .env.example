# Sentinel environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# Google Maps Platform API key for Photorealistic 3D Tiles.
# Restrict in Google Cloud Console: HTTP referrer = http://localhost:8000/*, API = Map Tiles API + Maps JavaScript API.
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Google AI (Gemini + Veo) API key. Can be the same as above if billing is configured for those APIs.
GOOGLE_AI_API_KEY=your_genai_api_key_here

# Gemini model id for the threat-analyst agent
GEMINI_MODEL=gemini-2.5-flash

# Veo model id
VEO_MODEL=veo-3.1-generate-001

# Run mode: real | stub
# stub = no external API calls; orchestrator emits synthetic incidents from scenarios.json
# real = call Veo + Managed Agents (requires API keys above and access to preview)
SENTINEL_MODE=stub

# Status broker host:port
SENTINEL_BROKER_HOST=127.0.0.1
SENTINEL_BROKER_PORT=8000

# Tick interval in seconds for the orchestrator
SENTINEL_TICK_SECONDS=4
