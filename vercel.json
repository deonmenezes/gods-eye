{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "node scripts/build_public.js",
  "outputDirectory": "public",
  "functions": {
    "api/tick.py": { "maxDuration": 30, "memory": 512 },
    "api/cameras.py": { "maxDuration": 5 },
    "api/config.py": { "maxDuration": 5 }
  },
  "rewrites": [
    { "source": "/config.js", "destination": "/api/config" },
    { "source": "/cameras", "destination": "/api/cameras" },
    { "source": "/tick", "destination": "/api/tick" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
